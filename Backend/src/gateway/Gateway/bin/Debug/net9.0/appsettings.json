{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "iamRoute": {
        "ClusterId": "iamCluster",
        "Match": {
          "Path": "/iam/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/iam" }
        ]
      },
      "portfolioRoute": {
        "ClusterId": "portfolioCluster",
        "Match": {
          "Path": "/portfolio/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/portfolio" }
        ]
      },
      "requestRoute": {
        "ClusterId": "requestCluster",
        "Match": {
          "Path": "/request/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/request" }
        ]
      }
    },
    "Clusters": {
      "iamCluster": {
        "Destinations": {
          "iam1": {
            "Address": "http://localhost:5209"
          }
        }
      },
      "portfolioCluster": {
        "Destinations": {
          "portfolio1": {
            "Address": "http://localhost:5118"
          }
        }
      },
      "requestCluster": {
        "Destinations": {
          "request1": {
            "Address": "http://localhost:5112"
          }
        }
      }
    }
  }
}
